---
import Logo from './Logo.astro';
import { url } from '../lib/url';
import { VERSION, RELEASE_STATE, REPO_URL } from '../lib/site';
const { docs = false } = Astro.props;
const links = [
  ['Docs', '/docs/'], ['Playground', '/playground/'], ['DSL', '/docs/dsl/'], ['CLI', '/docs/cli/'], ['Agents', '/docs/agents/'], ['Status', '/docs/status/'],
];
const path = Astro.url.pathname;
const cur = (h: string) => (url(h) === path ? 'page' : undefined);
---
<header class="nav">
  <div class="wrap">
    <a class="brand" href={url('/')} aria-label="Atalanta home"><Logo />Atalanta</a>
    <span class="badge">v{VERSION} · {RELEASE_STATE}</span>
    <nav class="nav-links" aria-label="Primary">
      {links.map(([l, h]) => <a href={url(h)} aria-current={cur(h)}>{l}</a>)}
    </nav>
    <div class="nav-right">
      <button class="search-btn" type="button" data-search-open aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="sr-only">Search the docs</span>
        <kbd class="label" data-mod>⌘K</kbd>
      </button>
      <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Toggle light and dark theme">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="icon-btn" href={REPO_URL} aria-label="Atalanta on GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg>
      </a>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  {!docs && (
    <nav class="menu-panel" aria-label="Mobile">
      {links.map(([l, h]) => <a href={url(h)}>{l}</a>)}
    </nav>
  )}
</header>
