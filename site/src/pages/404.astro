---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found" noindex>
  <section class="wrap" style="padding: 96px var(--gutter) 120px">
    <p style="font: 500 13px var(--mono); color: var(--faint); margin: 0 0 12px">404</p>
    <h1 style="font-size: clamp(2.2rem, 5vw, 3.6rem); letter-spacing: -0.035em; line-height: 1; font-weight: 600; margin: 0 0 16px">Page not found.</h1>
    <p style="color: var(--muted); max-width: 52ch">That address does not exist on this site. Try the docs, or search with <kbd>/</kbd>.</p>
    <p style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px">
      <a class="btn primary" href={url('/docs/')}>Open the docs</a>
      <a class="btn" href={url('/')}>Home</a>
    </p>
  </section>
</Base>
