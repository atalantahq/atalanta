---
import Base from './Base.astro';
import { url } from '../lib/url';
import { REPO_URL } from '../lib/site';
import { GROUPS } from '../lib/docs-config';
import '../styles/docs.css';
import type { DocPage } from '../lib/docs';

interface Props { page: DocPage }
const { page } = Astro.props;
const flat = GROUPS.flatMap((g) => g.pages);
const i = flat.findIndex((p) => p.source === page.source);
const prev = flat[i - 1], next = flat[i + 1];
const route = (slug: string) => url(slug ? `/docs/${slug}/` : '/docs/');
const toc = page.headings;
const mdUrl = url(`/docs/${page.slug || 'index'}.md`);
---
<Base title={page.slug ? page.title : 'Documentation'} description={page.description} docs bodyClass="docs" ogImage={`/og/${page.slug || 'index'}.png`}>
  <link slot="head" rel="alternate" type="text/markdown" href={mdUrl} />
  <div class="docs-shell wrap">
    <div class="scrim" data-scrim></div>
    <aside class="sidebar" aria-label="Documentation">
      <nav>
        <div class="drawer-links">
          <a href={url('/')}>Home</a><a href={url('/docs/dsl/')}>DSL</a><a href={url('/docs/cli/')}>CLI</a><a href={url('/docs/agents/')}>Agents</a><a href={url('/docs/status/')}>Status</a>
        </div>
        {GROUPS.map((g) => (
          <div class="side-group">
            <p class="side-title">{g.title}</p>
            <ul>
              {g.pages.map((p) => (
                <li><a href={route(p.slug)} aria-current={p.source === page.source ? 'page' : undefined}>{p.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <article class="article" data-pagefind-body>
      <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href={url('/docs/')}>Docs</a><span aria-hidden="true">/</span><span aria-current="page">{page.label}</span>
      </nav>
      <h1 data-pagefind-meta="title">{page.title}</h1>
      <div class="prose" set:html={page.html} />
      <footer class="doc-foot" data-pagefind-ignore>
        <p class="doc-links">
          <a href={`${REPO_URL}/edit/main/${page.source}`}>Edit this page on GitHub</a>
          <a href={mdUrl}>View as Markdown</a>
        </p>
        <nav class="pager" aria-label="Previous and next page">
          {prev ? <a class="prev" href={route(prev.slug)}><span>Previous</span>{prev.label}</a> : <span />}
          {next ? <a class="next" href={route(next.slug)}><span>Next</span>{next.label}</a> : <span />}
        </nav>
      </footer>
    </article>

    <aside class="toc" aria-label="On this page" data-pagefind-ignore>
      {toc.length > 0 && (
        <>
          <p class="side-title">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class={`d${h.depth}`}><a href={`#${h.id}`}>{h.text}</a></li>
            ))}
          </ul>
        </>
      )}
    </aside>
  </div>
</Base>
