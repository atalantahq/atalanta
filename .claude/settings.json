{
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(rustfmt *)",
      "Bash(adb *)",
      "Bash(xcrun simctl *)",
      "Bash(xcodebuild *)",
      "Bash(target/release/atalanta *)",
      "Bash(./target/release/atalanta *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in *.rs) \"$HOME/.cargo/bin/rustfmt\" --edition 2021 \"$f\";; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
