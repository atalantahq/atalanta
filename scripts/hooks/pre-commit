#!/usr/bin/env bash
# Opt-in pre-commit hook (scripts/install-hooks.sh): the fast checks on what
# is being committed. A missing tool is skipped with a note; the hook never
# needs the network. Bypass once with `git commit --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

bad=0
note() { printf 'pre-commit: %s\n' "$*" >&2; }

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Secrets in the staged changes.
if command -v gitleaks > /dev/null 2>&1; then
    gitleaks git --pre-commit --staged --config .gitleaks.toml --redact --no-banner . || {
        note "gitleaks found a possible secret in the staged changes"; bad=1; }
else
    note "gitleaks not installed (brew install gitleaks): secrets not checked"
fi

# Rust formatting of the staged files.
if printf '%s\n' "$staged" | grep -q '\.rs$' && command -v cargo > /dev/null 2>&1; then
    cargo fmt --all -- --check > /dev/null 2>&1 || { note "cargo fmt --all needed"; bad=1; }
    python3 -I scripts/unsafe-inventory.py --check > /dev/null || {
        note "more unsafe code than scripts/unsafe-baseline.txt allows (scripts/unsafe-inventory.py)"; bad=1; }
fi

# Shell scripts and workflows.
sh_files=$(printf '%s\n' "$staged" | grep -E '\.sh$|^scripts/hooks/' || true)
if [ -n "$sh_files" ] && command -v shellcheck > /dev/null 2>&1; then
    # shellcheck disable=SC2086 # one file per word
    shellcheck -x -P SCRIPTDIR $sh_files || bad=1
fi
if printf '%s\n' "$staged" | grep -qE '^\.github/|^action\.yml$'; then
    if command -v actionlint > /dev/null 2>&1; then
        actionlint || bad=1
    fi
    if command -v zizmor > /dev/null 2>&1; then
        rc=0
        zizmor --offline --min-severity low -q . || rc=$?
        [ "$rc" -eq 0 ] || { note "zizmor found workflow problems"; bad=1; }
    fi
fi

exit "$bad"
