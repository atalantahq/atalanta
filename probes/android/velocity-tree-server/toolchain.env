# The Android SDK pieces and JDK the committed velocity-tree.jar is built
# with. build.sh uses them by default and scripts/check-tree-jar.sh rebuilds
# with them; CI (ci.yml `tree-jar`, probes.yml) installs exactly these.
# d8 stamps its version into classes.dex, so a different build-tools gives a
# different jar: change these together with a rebuilt, committed jar.
# Plain KEY=value lines: sourced by sh, and read by the workflows.
TREE_PLATFORM=android-36
TREE_BUILD_TOOLS=36.1.0
# The exact Temurin build: javac 17.0.21 compiles Server.java to different
# class files than 17.0.9, and so a different jar (CI, 2026-11-22).
TREE_JDK=17.0.9+9
